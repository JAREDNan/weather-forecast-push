# ============================================================
# 校园气象预报自动编撰系统 —— 环境变量模板
# 复制本文件为 .env 后填入真实值。.env 已被 .gitignore 排除，禁止提交。
# ⚠️ 铁律：任何密钥不得写入代码、日志、报告或提交到远端仓库。
# ============================================================

# ---------- 和风天气 QWeather（可选，缺失则自动降级到官方源）----------
# 新版和风天气使用「账号专属 API Host」，不再是 devapi.qweather.com。
# 在 https://console.qweather.com/ 的「项目管理」页查看，形如 xxxxxx.qweatherapi.com
QWEATHER_API_HOST=
QWEATHER_API_KEY=
# 东昌府区 LocationID —— ⚠️ 未核实，需拿到 Key 后用 GeoAPI 查询：
#   GET https://{QWEATHER_API_HOST}/geo/v2/city/lookup?location=东昌府&adm=聊城&range=cn
# 返回 JSON 的 location[].id 即为所需值。切勿凭空填写。
QWEATHER_LOCATION_ID=

# ---------- 微信公众号（路线选定后再填；未填时只能跑 dry-run）----------
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 推送路线：subscription（订阅号每日群发）/ template（服务号模板消息）
#           / wecom_webhook（企业微信群机器人）/ dryrun（仅生成不推送）
# ⚠️ 本项目已确认「服务号群发每月4次」无法支撑每日推送，详见 reports/02_爬虫合规检查.md
WECHAT_PUSH_CHANNEL=dryrun

# ---------- 企业微信群机器人 Webhook（仅 WECHAT_PUSH_CHANNEL=wecom_webhook 时需要）----------
WECOM_WEBHOOK_URL=

# ---------- 服务号模板消息（仅 WECHAT_PUSH_CHANNEL=template 时需要）----------
WECHAT_TEMPLATE_ID=

# ---------- 异常告警（可选，任务失败时通知，避免静默失败）----------
# 三选一或都填；全部留空则仅写日志
ALERT_WECOM_WEBHOOK=
ALERT_SERVERCHAN_KEY=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=465
ALERT_EMAIL_USER=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_TO=
